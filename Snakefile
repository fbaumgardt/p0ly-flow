# p0ly-flow Snakemake DAG

# --- Config ---
configfile: "config.yaml"

# --- Config-derived path roots (no hardcoded directories in rules) ---
_DATA_DIR = config["project_settings"]["data_directory"].rstrip("/")
_OUT_DIR = config["project_settings"]["output_directory"].rstrip("/")
_TASK = config["project_settings"]["task"]
_FMT = config["project_settings"]["input_format"]

# Preprocessing config. All keys optional; ica_strategy present =>
# the preprocess rule also emits a fitted-ICA sidecar (see _ICA_OUT below).
_PP = config["preprocessing"]
_ICA_ENABLED = _PP.get("ica_strategy") is not None

# Metadata config. The experiment spec drives trial/Block/Onset
# extraction; csv_columns and expand_trials are optional companions.
_META = config["metadata"]

# The timelock set is derived from the experiment spec itself
# (``ExperimentSpec.timelocks`` keys) so no timelock literals live in the
# Snakefile. ``p0ly_utils`` is already a dependency, so the spec is loaded at
# DAG-parse time.
from p0ly_utils.analysis import freq_grid
from p0ly_utils.metadata import ExperimentSpec

_TIMELOCKS = list(ExperimentSpec.from_yaml(_META["experiment_spec"]).timelocks.keys())

# Optional ICA output path (declared as a plain value, not a function —
# Snakemake only allows callables for `input:`, not `output:`). Empty list
# when ICA is disabled so the rule emits no ICA file in that case.
_ICA_OUT = (
    f"{_OUT_DIR}/sub-{{subject}}/sub-{{subject}}_desc-ica.fif.gz"
    if _ICA_ENABLED
    else []
)

# `rule all` ICA target expansion (empty list when ICA disabled).
_ICA_TARGETS = (
    expand(_ICA_OUT, subject=config["subjects"])
    if _ICA_ENABLED
    else []
)

# --- Cohort expansion (US-015) ---
#
# participants.tsv (SCHEMA §3, config group_aggregation.cohort_file) is the
# single source of truth for cohort membership — a hand-curated file, not
# generated by scripts (age/gender/group labels cannot be derived from raw
# data). {cohort} expands over `aggregate_by_cohorts`; the reserved label
# `all_combined` groups every participant in the file. Cohort members outside
# config.subjects are a config error (their per-subject inputs would be
# unbuilt); configured subjects missing from the file simply contribute to no
# cohort. Group-level rules take {cohort} between {timelock} and {condition}
# (PRD §6: conditions stay encoded in file names, cohorts get a directory).
import pandas as _pd

_PARTICIPANTS_DF = _pd.read_csv(
    config["group_aggregation"]["cohort_file"],
    sep="\t",
    dtype={"participant_id": str, "cohort": str},
)
# SCHEMA §3 stores BIDS-style `sub-{id}` labels; the pipeline's subject axis
# is bare numeric IDs — strip the `sub-` prefix once at parse time.
_PARTICIPANTS_DF["participant_id"] = _PARTICIPANTS_DF[
    "participant_id"
].str.removeprefix("sub-")
_COHORTS = list(config["group_aggregation"]["aggregate_by_cohorts"])
_CONFIGURED_SUBJECTS = list(config["subjects"])
_COHORT_SUBJECTS: dict[str, list[str]] = {}
for _cohort in _COHORTS:
    if _cohort == "all_combined":
        _members = sorted(_PARTICIPANTS_DF["participant_id"])
    else:
        _members = sorted(
            _PARTICIPANTS_DF.loc[_PARTICIPANTS_DF["cohort"] == _cohort, "participant_id"]
        )
    if not _members:
        raise ValueError(
            f"cohort {_cohort!r} from group_aggregation.aggregate_by_cohorts "
            f"matched no participants in "
            f"{config['group_aggregation']['cohort_file']}"
        )
    _unknown = sorted(set(_members) - set(_CONFIGURED_SUBJECTS))
    if _unknown:
        raise ValueError(
            f"cohort {_cohort!r} lists subjects {_unknown} that are not in "
            f"config subjects {_CONFIGURED_SUBJECTS} — their per-subject "
            "outputs cannot be built"
        )
    _COHORT_SUBJECTS[_cohort] = _members

# Cohorts large enough for one-sample cluster permutation tests (ERP and TFR
# statistics share this gate, US-010 / US-026).
_CLUSTER_COHORTS = [
    _cohort for _cohort in _COHORTS if len(_COHORT_SUBJECTS[_cohort]) >= 2
]

# --- Group analysis config (US-010) ---
#
# ERP grand averages + cluster permutation contrasts (PRD stage 5). The
# implicit `all_trials` condition carries no query, so one grand average per
# timelock always exists even when `condition_splits` is empty; contrasts
# enumerate the unordered pairs of the explicit condition splits only (US-010
# Notes: all_trials is an average target, never a contrast arm).
from itertools import combinations

_ERP_ENABLED = config["analysis"]["run_erp"]
_ERP_SPLITS = config["group_aggregation"]["condition_splits"]
if "all_trials" in _ERP_SPLITS:
    raise ValueError(
        "config group_aggregation.condition_splits must not redefine the "
        "reserved 'all_trials' condition"
    )
_ERP_QUERIES = {"all_trials": None, **_ERP_SPLITS}
_ERP_STATS = config["erp"] if _ERP_ENABLED else {}
_ERP_CONTRASTS = {
    f"{first}-vs-{second}": (first, second)
    for first, second in combinations(_ERP_SPLITS, 2)
}
# Cluster permutation contrasts are a one-sample test over per-subject
# difference waves, so they need >= 2 subjects **per cohort** (US-015:
# gating is cohort-level — grand averages stay valid for a single-subject
# cohort; adding subjects re-parses the DAG and re-enables the contrast
# targets for that cohort).
_ERP_CONTRAST_COHORTS = _CLUSTER_COHORTS
if _ERP_ENABLED and _ERP_CONTRASTS:
    for _cohort in _COHORTS:
        if _cohort not in _ERP_CONTRAST_COHORTS:
            print(
                f"run_erp: cohort {_cohort!r} has "
                f"{len(_COHORT_SUBJECTS[_cohort])} subject(s) — cluster "
                "permutation contrast targets omitted from the DAG for this "
                "cohort; grand averages only (re-parse after adding subjects)"
            )

# Per-subject condition averages (rule erp_subject): keep every channel as a
# QC artifact; EEG-only selection + stats happen inside the library call.
_ERP_AVE_OUT = (
    f"{_OUT_DIR}/sub-{{subject}}/sub-{{subject}}_{{timelock}}_{{condition}}_desc-ave.fif.gz"
)
# Cohort-tier group layout (US-015): one {cohort} directory between
# {timelock} and the condition-named files (PRD §6).
_ERP_GROUP_AVE_OUT = (
    f"{_OUT_DIR}/group_analysis/{{timelock}}/{{cohort}}/{{condition}}_desc-ave.fif.gz"
)
_ERP_CONTRAST_NPZ_OUT = (
    f"{_OUT_DIR}/group_analysis/{{timelock}}/{{cohort}}/{{contrast}}_clusterperm.npz"
)
_ERP_CONTRAST_CSV_OUT = (
    f"{_OUT_DIR}/group_analysis/{{timelock}}/{{cohort}}/{{contrast}}_clusterperm.csv"
)

# `rule all` ERP target expansion (empty list when analysis.run_erp is false;
# contrast families additionally gated to cohorts with >= 2 subjects).
_ERP_TARGETS = (
    (
        expand(
            _ERP_GROUP_AVE_OUT,
            timelock=_TIMELOCKS,
            cohort=_COHORTS,
            condition=list(_ERP_QUERIES),
        )
        + (
            expand(
                [_ERP_CONTRAST_NPZ_OUT, _ERP_CONTRAST_CSV_OUT],
                timelock=_TIMELOCKS,
                cohort=_ERP_CONTRAST_COHORTS,
                contrast=list(_ERP_CONTRASTS),
            )
            if _ERP_CONTRASTS
            else []
        )
    )
    if _ERP_ENABLED
    else []
)

# --- PSD Analysis Layer (US-011) ---
#
# Absolute/relative band power + specparam aperiodic parameterization (PRD
# stage 5). The condition set is shared with the ERP layer (_ERP_QUERIES,
# built above with the all_trials guard). No statistics live in this module,
# so single-subject cohorts run the full rule set (no n >= 2 gating).
_PSD_ENABLED = config["analysis"]["run_psd"]
_PSD_QUERIES = _ERP_QUERIES
_PSD_SETTINGS = config["psd"] if _PSD_ENABLED else {}

# Per-subject condition spectra (rule psd_subject): every channel kept as a
# QC artifact. Containers are MNE Spectrum HDF5 files (h5io — Spectrum.save's
# native format; read back via mne.time_frequency.read_spectrum), NOT FIF:
# Spectrum persistence is HDF5-only in MNE 1.12. Cohort-tier group layout
# (US-015): {cohort} directory between {timelock} and the condition-named
# files (PRD §6).
_PSD_SUBJECT_OUT = (
    f"{_OUT_DIR}/sub-{{subject}}/sub-{{subject}}_{{timelock}}_{{condition}}_desc-psd.h5"
)
_PSD_GROUP_OUT = (
    f"{_OUT_DIR}/group_analysis/{{timelock}}/{{cohort}}/{{condition}}_desc-psd_ave.h5"
)
_PSD_PARAMS_OUT = (
    f"{_OUT_DIR}/group_analysis/{{timelock}}/{{cohort}}/{{condition}}_desc-psd_params.csv"
)
_PSD_BANDPOWER_OUT = (
    f"{_OUT_DIR}/group_analysis/{{timelock}}/{{cohort}}/{{condition}}_desc-psd_bandpower.csv"
)

# `rule all` PSD target expansion (empty list when analysis.run_psd is false);
# per-subject spectra stay intermediates feeding the group rules.
_PSD_TARGETS = (
    expand(
        [_PSD_GROUP_OUT, _PSD_PARAMS_OUT, _PSD_BANDPOWER_OUT],
        timelock=_TIMELOCKS,
        cohort=_COHORTS,
        condition=list(_PSD_QUERIES),
    )
    if _PSD_ENABLED
    else []
)

# --- TFR Analysis Layer (US-012) ---
#
# Morlet/multitaper complex TFR (one convolution) -> per-subject two-entry
# HDF5 files ([0] = epoch-mean power, [1] = ITPC — documented positional
# convention, verified by the rule scripts on read) + grand averages +
# per-contrast difference maps. Mirrors the PSD layer (ADR-007): condition
# set shared with ERP (_ERP_QUERIES), flat per-timelock group layout, and
# no n >= 2 gating — the difference map is a subtraction, defined at n=1
# (no statistics in this module; cluster permutation over channel x freq x
# time is a documented US-015 deferred alternative).
_TFR_ENABLED = config["analysis"]["run_tfr"]
_TFR_QUERIES = _ERP_QUERIES
_TFR_SETTINGS = config["tfr"] if _TFR_ENABLED else {}

# Per-subject condition TFRs (rule tfr_subject): every channel kept as a QC
# artifact. Containers are two-entry AverageTFR HDF5 files (h5io family via
# mne.time_frequency.write_tfrs/read_tfrs — verified live in MNE 1.12.1).
# Cohort-tier group layout (US-015): {cohort} directory between {timelock}
# and the condition/contrast-named files (PRD §6).
_TFR_SUBJECT_OUT = (
    f"{_OUT_DIR}/sub-{{subject}}/sub-{{subject}}_{{timelock}}_{{condition}}_desc-tfr.h5"
)
_TFR_GROUP_OUT = (
    f"{_OUT_DIR}/group_analysis/{{timelock}}/{{cohort}}/{{condition}}_desc-tfr_ave.h5"
)
_TFR_DIFF_OUT = (
    f"{_OUT_DIR}/group_analysis/{{timelock}}/{{cohort}}/{{contrast}}_desc-tfrdiff.h5"
)
# US-026: TFR cluster-permutation statistics (ADR-007 three-rule topology).
# Inputs are per-subject condition TFRs (not the group averages — the
# one-sample design needs the per-subject maps); outputs land beside the
# difference maps. Statistic: raw power difference; Fisher-z-transformed
# ITPC difference (itpc_z). Gated to cohorts with >= 2 subjects.
_TFR_CLUSTER_NPZ_OUT = (
    f"{_OUT_DIR}/group_analysis/{{timelock}}/{{cohort}}/{{contrast}}_tfrcluster.npz"
)
_TFR_CLUSTER_CSV_OUT = (
    f"{_OUT_DIR}/group_analysis/{{timelock}}/{{cohort}}/{{contrast}}_tfrcluster.csv"
)
_TFR_CLUSTER_COHORTS = _CLUSTER_COHORTS
if _TFR_ENABLED and _ERP_CONTRASTS:
    for _cohort in _COHORTS:
        if _cohort not in _TFR_CLUSTER_COHORTS:
            print(
                f"run_tfr_cluster: cohort {_cohort!r} has "
                f"{len(_COHORT_SUBJECTS[_cohort])} subject(s) — TFR cluster "
                "permutation targets omitted from the DAG for this cohort "
                "(difference maps remain valid at n=1)"
            )

# `rule all` TFR target expansion (empty when analysis.run_tfr is false);
# per-subject TFRs stay intermediates feeding the group rules. Contrast
# naming shares the ERP contrast set (unordered pairs of condition_splits).
_TFR_TARGETS: list[str]
if _TFR_ENABLED:
    _TFR_TARGETS = expand(
        _TFR_GROUP_OUT,
        timelock=_TIMELOCKS,
        cohort=_COHORTS,
        condition=list(_TFR_QUERIES),
    )
    if _ERP_CONTRASTS:
        _TFR_TARGETS += expand(
            _TFR_DIFF_OUT,
            timelock=_TIMELOCKS,
            cohort=_COHORTS,
            contrast=list(_ERP_CONTRASTS),
        )
        if _TFR_CLUSTER_COHORTS:
            _TFR_TARGETS += expand(
                [_TFR_CLUSTER_NPZ_OUT, _TFR_CLUSTER_CSV_OUT],
                timelock=_TIMELOCKS,
                cohort=_TFR_CLUSTER_COHORTS,
                contrast=list(_ERP_CONTRASTS),
            )
else:
    _TFR_TARGETS = []

# --- Connectivity Analysis Layer (US-013) ---
#
# One mne-connectivity call computes every configured method (wPLI /
# coherence / PLV) per (subject × timelock × condition) -> per-method
# adjacency (n_channels, n_channels, n_freqs) flattened to .npz archives +
# grand averages + graph metrics of the band-averaged group adjacencies.
# Mirrors the TFR/PSD layers (ADR-007): condition set shared with ERP
# (_ERP_QUERIES), flat per-timelock group layout, and no n >= 2 gating —
# graph metrics of a grand-averaged adjacency are defined at n=1 (no
# statistics in this module).
_CONN_ENABLED = config["analysis"]["run_connectivity"]
_CONN_QUERIES = _ERP_QUERIES
_CONN_SETTINGS = config["connectivity"] if _CONN_ENABLED else {}

# Per-subject condition connectivity (rule connectivity_subject): every
# channel kept as a QC artifact. Containers are .npz archives — one
# (n_channels, n_channels, n_freqs) adjacency per method + ch_names + freqs.
# Cohort-tier group layout (US-015): {cohort} directory between {timelock}
# and the condition-named files (PRD §6).
_CONN_SUBJECT_OUT = (
    f"{_OUT_DIR}/sub-{{subject}}/sub-{{subject}}_{{timelock}}_{{condition}}_desc-conn.npz"
)
_CONN_GROUP_OUT = (
    f"{_OUT_DIR}/group_analysis/{{timelock}}/{{cohort}}/{{condition}}_desc-conn_ave.npz"
)
_CONN_GRAPH_OUT = (
    f"{_OUT_DIR}/group_analysis/{{timelock}}/{{cohort}}/{{condition}}_desc-conn_graph.csv"
)
# Per-contrast difference graphs (US-013 deferral): graph metrics of the plain
# condition-first minus condition-second difference adjacency. Suffix
# `_diff-graph` keeps an unambiguous filename next to the per-condition
# `{condition}_desc-conn_graph.csv` files (the `contrast` wildcard carries a
# `-vs-`).
_CONN_CONTRAST_OUT = (
    f"{_OUT_DIR}/group_analysis/{{timelock}}/{{cohort}}/{{contrast}}_desc-conn_diff-graph.csv"
)

# `rule all` connectivity target expansion (empty when
# analysis.run_connectivity is false); per-subject archives stay
# intermediates feeding the group rules. There is still no contrast family
# of *subject-level* connectivity (the US-013 bias note stands); contrast
# targets are the graph metrics of a difference of the two grand means —
# defined for any n, no statistics involved.
_CONN_TARGETS: list[str]
if _CONN_ENABLED:
    _CONN_TARGETS = expand(
        _CONN_GROUP_OUT,
        timelock=_TIMELOCKS,
        cohort=_COHORTS,
        condition=list(_CONN_QUERIES),
    ) + expand(
        _CONN_GRAPH_OUT,
        timelock=_TIMELOCKS,
        cohort=_COHORTS,
        condition=list(_CONN_QUERIES),
    )
    if _ERP_CONTRASTS:
        _CONN_TARGETS += expand(
            _CONN_CONTRAST_OUT,
            timelock=_TIMELOCKS,
            cohort=_COHORTS,
            contrast=list(_ERP_CONTRASTS),
        )
else:
    _CONN_TARGETS = []

# --- Regression Analysis Layer (US-014) ---
#
# Single-trial OLS per (subject × timelock) of all retained trials on the
# declared ``regression:`` metadata predictors -> per-subject NPZ beta maps +
# equal-subject-weight cohort mean. No condition wildcard and no timelock
# contrasts: the model estimates declared predictors over the full trial set
# (condition splits are decoding/CFC concerns), and cohort outputs carry no
# inferential statistics. Power-domain regressions reuse the existing ``tfr:``
# transform settings even when ``analysis.run_tfr`` is false (all transforms
# live in p0ly-eeg — see the library regression module).
_REG_ENABLED = config["analysis"]["run_regression"]
_REG_SETTINGS = config.get("regression", {}) if _REG_ENABLED else {}
_REG_DOMAIN = _REG_SETTINGS.get("signal_domain", "voltage")
if _REG_ENABLED:
    if _REG_DOMAIN not in ("voltage", "power"):
        raise ValueError(
            f"regression.signal_domain must be 'voltage' or 'power', got "
            f"{_REG_DOMAIN!r}"
        )
    if not (
        _REG_SETTINGS.get("continuous") or _REG_SETTINGS.get("categorical")
    ):
        raise ValueError(
            "analysis.run_regression needs at least one declared predictor in "
            "regression.continuous or regression.categorical"
        )
# Power regressions need the tfr grid/settings regardless of run_tfr.
_REG_TFR_SETTINGS = (
    config["tfr"] if _REG_ENABLED and _REG_DOMAIN == "power" else {}
)

# Per-subject NPZ beta maps (rule regression_subject) and the cohort mean
# (rule run_regression). Cohort-tier layout (PRD §6); the cohort file is the
# only `desc-regression` name in it, so no condition wildcard is needed.
_REG_SUBJECT_OUT = (
    f"{_OUT_DIR}/sub-{{subject}}/sub-{{subject}}_{{timelock}}_desc-regression.npz"
)
_REG_GROUP_OUT = (
    f"{_OUT_DIR}/group_analysis/{{timelock}}/{{cohort}}/desc-regression_ave.npz"
)

# `rule all` regression target expansion (empty when analysis.run_regression
# is false); per-subject maps stay intermediates feeding the cohort rule.
_REG_TARGETS = (
    expand(_REG_GROUP_OUT, timelock=_TIMELOCKS, cohort=_COHORTS)
    if _REG_ENABLED
    else []
)
# --- Cross-Frequency Coupling Layer (US-027) ---
#
# Within-channel PAC (tensorpac, Gaussian-copula default) + n:m phase-phase
# coupling (Hilbert phases, mean resultant length) per (subject x timelock x
# condition) -> per-method map (n_channels, n_phase_freqs, n_amp_freqs) with a
# full surrogate null, equal-subject descriptive cohort means, and one
# subject-as-unit condition contrast with full-map max-statistic correction.
# Mirrors the connectivity/TFR layers (ADR-007): the condition set is shared
# with ERP (_ERP_QUERIES), artifacts sit under the cohort-tier group layout.
#
# Evidence split: subject maps/null/p-values are subject-level descriptive
# evidence (uncorrected); the cohort average is descriptive only (no averaged
# p-values); only `run_cfc` is inference, and it runs on per-subject observed
# maps — never on subject surrogate p-values.
_CFC_ENABLED = config["analysis"]["run_cfc"]
_CFC_QUERIES = _ERP_QUERIES


def _cfc_grid(section: dict) -> list[float]:
    """Inclusive center grid from config (same builder as every other grid)."""
    return [float(f) for f in freq_grid(section["fmin"], section["fmax"], section["step"])]


_CFC_SETTINGS: dict[str, object] = {}
if _CFC_ENABLED:
    _CFC = config["cfc"]
    _CFC_SETTINGS = {
        "methods": list(_CFC["methods"]),
        "pac_method": str(_CFC["pac_method"]),
        "phase_freqs": _cfc_grid(_CFC["phase_freqs"]),
        "amp_freqs": _cfc_grid(_CFC["amp_freqs"]),
        # bandwidths are FULL widths: band = [f - w/2, f + w/2]
        "phase_bandwidth": float(_CFC["phase_freqs"]["bandwidth"]),
        "amp_bandwidth": float(_CFC["amp_freqs"]["bandwidth"]),
        "ratios": [[int(n), int(m)] for n, m in _CFC["ratios"]],
        "ratio_tolerance": float(_CFC["ratio_tolerance"]),
        "n_surrogates": int(_CFC["n_surrogates"]),
        "n_permutations": int(_CFC["n_permutations"]),
        "seed": _CFC["seed"],
        "n_jobs": int(_CFC["n_jobs"]),
    }

# Per-subject condition CFC maps + full surrogate null (rule cfc_subject):
# `<key>__observed` / `<key>__null` / `<key>__p_values` / `<key>__valid_mask`
# per method key (`pac`, `ppc_2x1`, ...) in a compressed .npz archive.
_CFC_SUBJECT_OUT = (
    f"{_OUT_DIR}/sub-{{subject}}/sub-{{subject}}_{{timelock}}_{{condition}}_desc-cfc.npz"
)
# Descriptive cohort mean (rule cfc_group_average) at any n >= 1: observed
# maps only, no averaged p-values, off-ratio NaN cells preserved.
_CFC_GROUP_OUT = (
    f"{_OUT_DIR}/group_analysis/{{timelock}}/{{cohort}}/{{condition}}_desc-cfc_ave.npz"
)
# Subject-as-unit contrast + full-map corrected p-values (rule run_cfc).
_CFC_CONTRAST_OUT = (
    f"{_OUT_DIR}/group_analysis/{{timelock}}/{{cohort}}/{{contrast}}_cfcperm.npz"
)
# Cohort inference needs >= 2 paired subjects per cohort (US-015 gate, shared
# with the ERP/TFR statistics). Exact sign-flip enumeration tops out at
# 2 ** (n_subjects - 1) null maxima, so small cohorts cannot reach p < 0.05 —
# see the run_cfc docstring and SCHEMA.
_CFC_CONTRAST_COHORTS = _CLUSTER_COHORTS
if _CFC_ENABLED:
    for _cohort in _COHORTS:
        if _cohort not in _CFC_CONTRAST_COHORTS:
            print(
                f"run_cfc: cohort {_cohort!r} has "
                f"{len(_COHORT_SUBJECTS[_cohort])} subject(s) — CFC cohort "
                "contrast targets omitted from the DAG for this cohort "
                "(descriptive maps remain valid at n=1; re-parse after adding "
                "subjects for inference)"
            )

# `rule all` CFC target expansion (empty when analysis.run_cfc is false).
_CFC_TARGETS: list[str]
if _CFC_ENABLED:
    _CFC_TARGETS = expand(
        _CFC_GROUP_OUT,
        timelock=_TIMELOCKS,
        cohort=_COHORTS,
        condition=list(_CFC_QUERIES),
    )
    if _ERP_CONTRASTS:
        _CFC_TARGETS += expand(
            _CFC_CONTRAST_OUT,
            timelock=_TIMELOCKS,
            cohort=_CFC_CONTRAST_COHORTS,
            contrast=list(_ERP_CONTRASTS),
        )
else:
    _CFC_TARGETS = []

# --- Variability Analysis Layer (US-029) ---
#
# Across-trial variability per (subject x timelock x condition): signed
# voltage epochs support the sample SD only, nonnegative TFR power supports
# SD + Fano + CV. Mirrors the PSD/TFR/connectivity layers (ADR-007): condition
# set shared with ERP (_ERP_QUERIES), cohort-tier group layout, and no n >= 2
# gating — a mean of per-subject maps is defined at n=1 (no statistics in
# this module). The power domain consumes the `tfr:` block independently of
# `analysis.run_tfr`, so power-only variability needs no TFR artifacts.
_VARIABILITY_ENABLED = config["analysis"]["run_variability"]
_VARIABILITY_QUERIES = _ERP_QUERIES
_VARIABILITY_SETTINGS = (
    (config.get("variability") or {}) if _VARIABILITY_ENABLED else {}
)
if _VARIABILITY_ENABLED and not ({"voltage", "power"} & set(_VARIABILITY_SETTINGS)):
    raise ValueError(
        "analysis.run_variability is true but config variability: declares no "
        "domain — add at least one of 'voltage' (measures: [sd]) or 'power' "
        "(measures: [sd, fano, cv])"
    )
# TFR settings for the power domain only (independent of analysis.run_tfr).
_VARIABILITY_TFR = (
    config["tfr"] if "power" in _VARIABILITY_SETTINGS else None
)

# Per-subject variability maps (rule variability_subject): one ``.npz``
# archive per (subject, timelock, condition) holding every configured domain
# and measure, so the DAG has no per-measure wildcard. Cohort-tier group
# layout (US-015): {cohort} directory between {timelock} and the files.
_VARIABILITY_SUBJECT_OUT = (
    f"{_OUT_DIR}/sub-{{subject}}/sub-{{subject}}_{{timelock}}_{{condition}}_desc-variability.npz"
)
_VARIABILITY_GROUP_OUT = (
    f"{_OUT_DIR}/group_analysis/{{timelock}}/{{cohort}}/{{condition}}_desc-variability_ave.npz"
)

# `rule all` variability target expansion (empty when
# analysis.run_variability is false); per-subject archives stay intermediates
# feeding the group rule. No contrast or statistics targets (out of scope).
_VARIABILITY_TARGETS = (
    expand(
        _VARIABILITY_GROUP_OUT,
        timelock=_TIMELOCKS,
        cohort=_COHORTS,
        condition=list(_VARIABILITY_QUERIES),
    )
    if _VARIABILITY_ENABLED
    else []
)

# --- Wildcard Constraints ---
wildcard_constraints:
    subject = r"\d+",
    timelock = r"[a-z]+",
    cohort = r"[a-z_]+",
    condition = r"[a-z_]+",
    contrast = r"[a-z_]+-vs-[a-z_]+"


# --- Manifest-driven ingestion input resolver (US-009) ---
#
# `metadata/manifest.tsv` (path from `config.yaml ingestion.manifest`) is the
# single source of truth for *which recording segments exist per subject*
# (ADR-005 §3 amendment). One row per segment: (subject, segment, source).
# The `raw_ingestion` rule resolves every source for a subject and merges the
# segments in one shot (no per-segment intermediate FIFs — collapsed in the
# first US-009 step). Regenerate the manifest after adding/raw-arranging data
# via `scripts/create_tsv.py` (standalone CLI, not a Snakemake script).
# (pandas already imported above for the cohort resolver, US-015.)

_MANIFEST = config["ingestion"]["manifest"]

# One row per recording segment: (subject, segment, source). subject/segment
# are forced to str so wildcard comparisons (always str) match the manifest.
# groupby(sort=False) preserves manifest row order within each subject.
_MANIFEST_ROWS: dict[str, list[tuple[str, str]]] = (
    _pd.read_csv(
        _MANIFEST, sep="\t", dtype={"subject": str, "segment": str}
    )
    .groupby("subject", sort=False)[["segment", "source"]]
    .apply(lambda _g: list(_g.itertuples(index=False, name=None)))
    .to_dict()
)


def _subject_sources(subject: str) -> list[str]:
    return [src for _, src in _MANIFEST_ROWS.get(subject, [])]


# --- Target Rule ---
rule all:
    input:
        expand(
            f"{_OUT_DIR}/sub-{{subject}}/sub-{{subject}}_desc-raw.fif.gz",
            subject=config["subjects"],
        ),
        expand(
            f"{_OUT_DIR}/sub-{{subject}}/sub-{{subject}}_desc-clean-raw.fif.gz",
            subject=config["subjects"],
        ),
        # ICA sidecar target only when ICA is enabled in config (US-008).
        _ICA_TARGETS,
        # US-016: per-subject trial metadata TSV (input to the epoch rule).
        expand(
            f"{_OUT_DIR}/sub-{{subject}}/sub-{{subject}}_metadata.tsv",
            subject=config["subjects"],
        ),
        # US-017: per-(subject × timelock) epochs + excluded-trials sidecar.
        expand(
            f"{_OUT_DIR}/sub-{{subject}}/sub-{{subject}}_{{timelock}}_desc-epo.fif.gz",
            subject=config["subjects"],
            timelock=_TIMELOCKS,
        ),
        expand(
            f"{_OUT_DIR}/sub-{{subject}}/sub-{{subject}}_{{timelock}}_excluded_trials.csv",
            subject=config["subjects"],
            timelock=_TIMELOCKS,
        ),
        # US-010: ERP group analysis when enabled in config (analysis.run_erp;
        # contrast families parse-time-gated to cohorts with >= 2 subjects).
        _ERP_TARGETS,
        # US-011: PSD band powers + aperiodic parameterization when enabled
        # (analysis.run_psd; no n >= 2 gating — no statistics in this module).
        _PSD_TARGETS,
        # US-012: TFR grand averages + per-contrast difference maps when
        # enabled in config (analysis.run_tfr; no n >= 2 gating — a
        # subtraction is defined at n=1).
        _TFR_TARGETS,
        # US-013: connectivity grand averages + band graph metrics when
        # enabled in config (analysis.run_connectivity; no n >= 2 gating —
        # graph metrics of a grand average are defined at n=1).
        _CONN_TARGETS,
        # US-014: equal-subject-weight regression beta maps when enabled in
        # config (analysis.run_regression; no statistics in this module).
        _REG_TARGETS,
        # US-027: CFC descriptive cohort maps at any n, plus the subject-unit
        # contrast with full-map correction for cohorts with >= 2 subjects.
        _CFC_TARGETS,
        # US-029: across-trial variability maps when enabled in config
        # (analysis.run_variability; descriptive only — no inferential output).
        _VARIABILITY_TARGETS,


# --- Ingestion Layer (US-007 / US-009) ---
# Manifest-driven, one rule per subject: the manifest's rows for the subject
# are resolved at DAG time (input) and merged at runtime by the script, which
# calls `p0ly_utils.merge_recordings` (BAD_break boundaries, channel/sfreq
# validation) over the per-segment Raw objects loaded via `load_raw`. No
# per-segment intermediate FIFs are written (first US-009 step); the two-rule
# split (per-segment ingest + merge) is a future scaling lever for per-segment
# parallelism if needed.
rule raw_ingestion:
    """Ingest and merge a subject's manifest-listed raw segments into one FIF.

    For each manifest row ``(segment, source)`` the script builds the per-format
    ``source`` (BV: concrete ``.vhdr`` path; BIDS: pipeline-constructed
    ``BIDSPath`` — single-segment BIDS only in this first step) and loads it via
    ``p0ly_utils.io.load_raw``, then concatenates the segments with
    ``p0ly_utils.merge.merge_recordings``. Channel types + montage are fixed on
    each segment by ``load_raw`` and preserved by ``mne.concatenate_raws``; a
    single-segment subject passes through ``merge_recordings`` unchanged.
    Output: ``sub-{subject}_desc-raw.fif.gz`` consumed by ``preprocess``.
    """
    conda:
        "envs/snakemake.yaml"
    input:
        source_paths=lambda wildcards: _subject_sources(wildcards.subject),
    output:
        f"{_OUT_DIR}/sub-{{subject}}/sub-{{subject}}_desc-raw.fif.gz",
    params:
        rows=lambda wildcards: _MANIFEST_ROWS.get(wildcards.subject, []),
        fmt=_FMT,
        subject="{subject}",
        task=_TASK,
        montage=config["project_settings"]["montage"],
        data_dir=_DATA_DIR,
        datatype="eeg",
    log:
        "logs/sub-{subject}/raw_ingestion.log",
    script:
        "scripts/ingest_raw.py"


# --- Preprocessing Layer (US-008) ---
rule preprocess:
    """Continuous-data preprocessing on un-segmented raw.

    Chains filter -> bad-channels -> ICA -> sliding-window reject in a single
    rule (PRD Core App §3 stage 2) so that any change to a preprocessing
    parameter recomputes the whole subject without exploding intermediate FIF
    checkpoints. All tunables arrive from config['preprocessing'] via
    snakemake.params; the rule body holds no math — algorithms live in
    p0ly_utils.preprocessing.

    Outputs:
      - sub-{subject}_desc-clean-raw.fif.gz : cleaned continuous raw carrying
        bad-interval Annotations (consumed by the downstream `epoch` rule).
      - bad_channels.json : pre-interpolation flagged channels + ica_strategy +
        ICA component-exclusion summary (``n_components``/``exclude``/``method``).
      - sub-{subject}_desc-ica.fif.gz : fitted ICA object, emitted only when
        `ica_strategy` is set in config (optional output via _ica_output).
    """
    conda:
        "envs/snakemake.yaml"
    input:
        raw=f"{_OUT_DIR}/sub-{{subject}}/sub-{{subject}}_desc-raw.fif.gz",
    output:
        raw=f"{_OUT_DIR}/sub-{{subject}}/sub-{{subject}}_desc-clean-raw.fif.gz",
        bads=f"{_OUT_DIR}/sub-{{subject}}/bad_channels.json",
        ica=_ICA_OUT,
    params:
        pp=config["preprocessing"],
    log:
        "logs/sub-{subject}/preprocess.log",
    script:
        "scripts/preprocess.py"


# --- Metadata Layer (US-016) ---
rule inject_metadata:
    """Compute by-trial metadata from the cleaned raw's event-marker Annotations.

    Reads the cleaned continuous raw (US-008 output) — which carries the
    Psychtoolbox Stim Annotations and recomputes whenever preprocessing changes
    — extracts the event frame, and runs ``p0ly_utils.metadata.parse_metadata``
    against the experiment spec referenced by ``config.yaml``
    ``metadata.experiment_spec``. Writes a per-subject TSV (SCHEMA §6:
    ``sub-{subject}_metadata.tsv``).

    Metadata only: this rule does not epoch or bind metadata to ``mne.Epochs``
    (that is US-017). The spec path, optional companion CSV, and trial-expansion
    flag all arrive from ``config['metadata']`` via ``snakemake.params`` — no
    hardcoded experiment names.
    """
    conda:
        "envs/snakemake.yaml"
    input:
        raw=f"{_OUT_DIR}/sub-{{subject}}/sub-{{subject}}_desc-clean-raw.fif.gz",
    output:
        f"{_OUT_DIR}/sub-{{subject}}/sub-{{subject}}_metadata.tsv",
    params:
        spec_path=_META["experiment_spec"],
        csv_columns=_META.get("csv_columns"),
        expand_trials=_META.get("expand_trials", False),
    log:
        "logs/sub-{subject}/inject_metadata.log",
    script:
        "scripts/parse_metadata.py"


# --- Epoching Layer (US-017) ---
rule epoch:
    """Segment each subject's clean continuous raw into per-timelock epochs.

    Cuts ``mne.Epochs`` from the timelock's annotation events using the
    analysis-run ``intervals[timelock]`` -> ``(tmin, tmax)`` (from
    ``config.yaml epoching.intervals``, ADR-006) and the shared ``baseline``
    (``config.yaml epoching.baseline``), then aligns the US-016 by-trial
    metadata TSV to those epochs via
    ``p0ly_utils.epoching.epoch_with_metadata``. Mismatches (extra epochs,
    missing epochs, bad-interval drops) are written to the per-timelock
    ``excluded_trials.csv`` sidecar (SCHEMA §6) rather than silently dropped.
    The ``{timelock}`` wildcard propagates to downstream cohort/condition /
    analysis rules (PRD §3).

    Inputs:
      - sub-{subject}_desc-clean-raw.fif.gz : US-008 cleaned continuous raw
        carrying event-marker + bad-interval Annotations.
      - sub-{subject}_metadata.tsv : US-016 by-trial metadata.
    Outputs:
      - sub-{subject}_{timelock}_desc-epo.fif.gz : epochs with aligned metadata.
      - sub-{subject}_{timelock}_excluded_trials.csv : mismatch log.

    The timelock set comes from the experiment spec (``_TIMELOCKS`` above),
    not config literals; per-timelock ``(tmin, tmax)`` come from
    ``config.yaml epoching.intervals`` (ADR-006: windows are analysis-run
    config; the spec owns the event-code map only).  No segmentation/
    alignment math here -- algorithms live in p0ly-eeg.
    """
    conda:
        "envs/snakemake.yaml"
    input:
        raw=f"{_OUT_DIR}/sub-{{subject}}/sub-{{subject}}_desc-clean-raw.fif.gz",
        metadata=f"{_OUT_DIR}/sub-{{subject}}/sub-{{subject}}_metadata.tsv",
    output:
        epochs=f"{_OUT_DIR}/sub-{{subject}}/sub-{{subject}}_{{timelock}}_desc-epo.fif.gz",
        excluded=f"{_OUT_DIR}/sub-{{subject}}/sub-{{subject}}_{{timelock}}_excluded_trials.csv",
    params:
        spec_path=_META["experiment_spec"],
        baseline=config["epoching"]["baseline"],
        intervals=config["epoching"]["intervals"],
        timelock="{timelock}",
        expand_trials=_META.get("expand_trials", False),
    log:
        "logs/sub-{subject}/epoch_{timelock}.log",
    script:
        "scripts/epoch.py"


# --- ERP Analysis Layer (US-010) ---
# Per-subject condition averages (erp_subject) feed the two group rules;
# the split keeps per-subject QC artifacts independent of group
# recomputation. All math lives in p0ly_utils.analysis (DoD: no algorithm
# logic in rule scripts); cluster permutation contrasts are omitted from
# the DAG at parse time for cohorts with < 2 subjects.
rule erp_subject:
    """Average one subject's epochs for one (timelock, condition) pair.

    Reads the US-017 ``sub-{subject}_{timelock}_desc-epo.fif.gz`` epochs
    (carrying trial metadata) and selects the condition via its
    ``metadata.eval`` query from ``config.yaml
    group_aggregation.condition_splits``; the reserved ``all_trials``
    condition applies no query. ``p0ly_utils.analysis.average_epochs``
    performs selection + averaging and fails loud on zero epochs or zero
    query matches (US-024 philosophy). The output keeps every channel
    (per-subject QC artifact).
    """
    conda:
        "envs/snakemake.yaml"
    input:
        epochs=f"{_OUT_DIR}/sub-{{subject}}/sub-{{subject}}_{{timelock}}_desc-epo.fif.gz",
    output:
        ave=_ERP_AVE_OUT,
    params:
        condition_query=lambda wildcards: _ERP_QUERIES[wildcards.condition],
    log:
        "logs/sub-{subject}/erp_subject_{timelock}_{condition}.log",
    script:
        "scripts/erp_subject.py"


rule erp_group_average:
    """Equal-weight grand average across a cohort's subjects (timelock, condition).

    Consumes the per-subject ``desc-ave`` files (rule erp_subject) of the
    cohort's members only (US-015: membership from ``participants.tsv``) and
    writes ``group_analysis/{timelock}/{cohort}/{condition}_desc-ave.fif.gz``
    (cohort-tier layout, PRD §6). ``p0ly_utils.analysis.grand_average``
    equal-weights every subject regardless of trial counts.
    """
    conda:
        "envs/snakemake.yaml"
    input:
        subject_averages=lambda wildcards: expand(
            _ERP_AVE_OUT,
            subject=_COHORT_SUBJECTS[wildcards.cohort],
            timelock=wildcards.timelock,
            condition=wildcards.condition,
        ),
    output:
        ave=_ERP_GROUP_AVE_OUT,
    log:
        "logs/group/erp_group_average_{timelock}_{cohort}_{condition}.log",
    script:
        "scripts/erp_group_average.py"


rule run_erp:
    """Cluster permutation contrast across a cohort's subjects (PRD stage 5).

    Inputs are the cohort's per-subject condition evokeds (rule erp_subject,
    US-015 cohort-restricted) for both contrast arms.
    ``p0ly_utils.analysis.group_erp`` builds the per-subject
    difference waves (cond_first - cond_second), picks EEG-only channels so
    they align with the montage-derived channel adjacency, and runs the
    one-sample cluster permutation test against zero with ``config.yaml erp``
    statistics settings; it fails loud on < 2 subjects (the DAG omits
    contrast targets for cohorts with fewer subjects — see
    _ERP_CONTRAST_COHORTS, so this guard only trips on forced/stale runs).

    Outputs (cohort-tier under group_analysis/{timelock}/{cohort}/, one job
    writes both):
      - {cond_first}-vs-{cond_second}_clusterperm.npz : t_obs
        (n_channels, n_times), per-cluster p-values, sign-flip null maxima
        (h0; length = unique permutations actually used) + settings echo.
      - .csv : one row per detected cluster — index arrays are pixel-wise
        (values repeat), so n_channels/n_times count distinct values and
        n_pixels the total mass; header-only when no cluster formed.
    """
    conda:
        "envs/snakemake.yaml"
    input:
        cond_first=lambda wildcards: expand(
            _ERP_AVE_OUT,
            subject=_COHORT_SUBJECTS[wildcards.cohort],
            timelock=wildcards.timelock,
            condition=_ERP_CONTRASTS[wildcards.contrast][0],
        ),
        cond_second=lambda wildcards: expand(
            _ERP_AVE_OUT,
            subject=_COHORT_SUBJECTS[wildcards.cohort],
            timelock=wildcards.timelock,
            condition=_ERP_CONTRASTS[wildcards.contrast][1],
        ),
    output:
        npz=_ERP_CONTRAST_NPZ_OUT,
        csv=_ERP_CONTRAST_CSV_OUT,
    params:
        conditions=lambda wildcards: _ERP_CONTRASTS[wildcards.contrast],
        stats=_ERP_STATS,
    log:
        "logs/group/run_erp_{timelock}_{cohort}_{contrast}.log",
    script:
        "scripts/erp.py"


# --- PSD Analysis Layer (US-011) ---
# Welch spectra per (subject, timelock, condition) feed two group rules; the
# split mirrors the ERP layer (ADR-007): per-subject QC artifacts, group
# averages, and per-condition parameterization. All math lives in
# p0ly_utils.analysis (DoD: no algorithm logic in rule scripts); single-subject
# cohorts run everything (no statistics in this module).
rule psd_subject:
    """Welch spectrum of one subject's epochs for one (timelock, condition).

    Reads the US-017 ``sub-{subject}_{timelock}_desc-epo.fif.gz`` epochs
    (carrying trial metadata), selects the condition via its ``metadata.eval``
    query from ``config.yaml group_aggregation.condition_splits`` (the
    reserved ``all_trials`` condition applies no query), and computes the
    Welch spectrum with ``config.yaml psd`` settings.
    ``p0ly_utils.analysis.psd_by_condition`` fails loud on zero query matches
    (US-024 philosophy). The spectrum keeps every channel (per-subject QC
    artifact) and is written as MNE Spectrum HDF5 (h5io — Spectrum.save's
    native container; not FIF).
    """
    conda:
        "envs/snakemake.yaml"
    input:
        epochs=f"{_OUT_DIR}/sub-{{subject}}/sub-{{subject}}_{{timelock}}_desc-epo.fif.gz",
    output:
        psd=_PSD_SUBJECT_OUT,
    params:
        condition="{condition}",
        condition_query=lambda wildcards: _PSD_QUERIES[wildcards.condition],
        psd=_PSD_SETTINGS,
    log:
        "logs/sub-{subject}/psd_subject_{timelock}_{condition}.log",
    script:
        "scripts/psd_subject.py"


rule psd_group_average:
    """Equal-weight grand-average spectrum across a cohort's subjects.

    Consumes the cohort's per-subject ``desc-psd`` files (rule psd_subject,
    US-015 cohort-restricted) and writes
    ``group_analysis/{timelock}/{cohort}/{condition}_desc-psd_ave.h5`` (MNE
    Spectrum HDF5) via ``p0ly_utils.analysis.group_psd`` (frequency-grid +
    channel-set guards).
    """
    conda:
        "envs/snakemake.yaml"
    input:
        subject_psds=lambda wildcards: expand(
            _PSD_SUBJECT_OUT,
            subject=_COHORT_SUBJECTS[wildcards.cohort],
            timelock=wildcards.timelock,
            condition=wildcards.condition,
        ),
    output:
        ave=_PSD_GROUP_OUT,
    log:
        "logs/group/psd_group_average_{timelock}_{cohort}_{condition}.log",
    script:
        "scripts/psd_group_average.py"


rule run_psd:
    """Aperiodic parameterization + band powers for one (timelock, condition).

    Fits specparam (fixed mode, library defaults) to every subject's
    per-condition spectrum and to the grand-average spectrum, and computes
    absolute/relative band power per channel from ``config.yaml psd`` (bands
    + norm_range). Outputs (flat per-timelock, one job writes both):
      - {condition}_desc-psd_params.csv : one row per (subject, channel) plus
        a ``subject == 'group_average'`` row fit on the grand-average spectrum
        — columns offset, exponent, knee_frequency (empty in fixed mode),
        r_squared, error_mae, n_peaks, and peak_centers/peak_powers/
        peak_widths (space-separated lists).
      - {condition}_desc-psd_bandpower.csv : one row per (subject, channel,
        band) — absolute (V^2/Hz mean density) and relative (fraction of the
        norm_range mass) power.
    """
    conda:
        "envs/snakemake.yaml"
    input:
        subject_psds=lambda wildcards: expand(
            _PSD_SUBJECT_OUT,
            subject=_COHORT_SUBJECTS[wildcards.cohort],
            timelock=wildcards.timelock,
            condition=wildcards.condition,
        ),
        group_average=_PSD_GROUP_OUT,
    output:
        params=_PSD_PARAMS_OUT,
        bandpower=_PSD_BANDPOWER_OUT,
    params:
        condition="{condition}",
        bands=_PSD_SETTINGS.get("bands", {}),
        norm_range=_PSD_SETTINGS.get("norm_range"),
    log:
        "logs/group/run_psd_{timelock}_{cohort}_{condition}.log",
    script:
        "scripts/run_psd.py"


# --- TFR Analysis Layer (US-012) ---
# Complex Morlet/multitaper transforms per (subject, timelock, condition) —
# reduced in-memory to a two-entry [power, ITPC] HDF5 — feed two group
# rules; the split mirrors the ERP/PSD layers (ADR-007): per-subject QC
# artifacts, group averages, per-contrast difference maps. All math lives
# in p0ly_utils.analysis (DoD: no algorithm logic in rule scripts);
# single-subject cohorts run everything (difference is defined at n=1).
rule tfr_subject:
    """Complex TFR -> [power, ITPC] for one subject's (timelock, condition).

    Reads the US-017 ``sub-{subject}_{timelock}_desc-epo.fif.gz`` epochs
    (carrying trial metadata), selects the condition via its ``metadata.eval``
    query from ``config.yaml group_aggregation.condition_splits`` (the
    reserved ``all_trials`` condition applies no query), and computes the
    single-trial complex TFR with ``config.yaml tfr`` settings — one
    convolution (``p0ly_utils.analysis.tfr_epochs``) reduced immediately to
    epoch-mean power (:func:`average_power`) and ITPC (:func:`itpc`); the
    large complex transient never touches disk. Fails loud on zero query
    matches (US-024 philosophy). The result keeps every channel (per-subject
    QC artifact) and is written as a two-entry AverageTFR HDF5 (h5io —
    write_tfrs/read_tfrs; positional convention [0]=power, [1]=ITPC).
    """
    conda:
        "envs/snakemake.yaml"
    input:
        epochs=f"{_OUT_DIR}/sub-{{subject}}/sub-{{subject}}_{{timelock}}_desc-epo.fif.gz",
    output:
        tfr=_TFR_SUBJECT_OUT,
    params:
        condition="{condition}",
        condition_query=lambda wildcards: _TFR_QUERIES[wildcards.condition],
        tfr=_TFR_SETTINGS,
    log:
        "logs/sub-{subject}/tfr_subject_{timelock}_{condition}.log",
    script:
        "scripts/tfr_subject.py"


rule tfr_group_average:
    """Equal-weight grand average of [power, ITPC] across subjects.

    Consumes the per-subject ``desc-tfr`` files (rule tfr_subject) and writes
    ``group_analysis/{timelock}/{condition}_desc-tfr_ave.h5`` (two-entry
    AverageTFR HDF5) via ``p0ly_utils.analysis.group_tfr`` (mne.grand_average
    with frequency-grid + channel-set guards), independently for the power
    and ITPC entries.
    """
    conda:
        "envs/snakemake.yaml"
    input:
        subject_tfrs=lambda wildcards: expand(
            _TFR_SUBJECT_OUT,
            subject=_COHORT_SUBJECTS[wildcards.cohort],
            timelock=wildcards.timelock,
            condition=wildcards.condition,
        ),
    output:
        ave=_TFR_GROUP_OUT,
    log:
        "logs/group/tfr_group_average_{timelock}_{cohort}_{condition}.log",
    script:
        "scripts/tfr_group_average.py"


rule run_tfr:
    """Difference map (cond_first - cond_second) for one timelock contrast.

    Inputs are the two group-average ``desc-tfr_ave.h5`` files (rule
    tfr_group_average — two reads, not 2 x N subject re-reads). Each file's
    [power, ITPC] entries are subtracted element-wise with
    ``p0ly_utils.analysis.tfr_difference`` (grid + channel guards) and
    written as a two-entry ``{condA}-vs-{condB}_desc-tfrdiff.h5``. No
    statistical test: subtraction is defined at n=1 (a single-subject
    difference is honest — group averages of one subject). Cluster
    permutation over (channel x freq x time) is a documented US-015
    deferred alternative.
    """
    conda:
        "envs/snakemake.yaml"
    input:
        cond_first=lambda wildcards: expand(
            _TFR_GROUP_OUT,
            timelock=wildcards.timelock,
            cohort=wildcards.cohort,
            condition=_ERP_CONTRASTS[wildcards.contrast][0],
        ),
        cond_second=lambda wildcards: expand(
            _TFR_GROUP_OUT,
            timelock=wildcards.timelock,
            cohort=wildcards.cohort,
            condition=_ERP_CONTRASTS[wildcards.contrast][1],
        ),
    output:
        diff=_TFR_DIFF_OUT,
    params:
        conditions=lambda wildcards: _ERP_CONTRASTS[wildcards.contrast],
    log:
        "logs/group/run_tfr_{timelock}_{cohort}_{contrast}.log",
    script:
        "scripts/run_tfr.py"


rule run_tfr_cluster:
    """Cluster permutation contrast over the TFR difference grid (US-026).

    ADR-007 three-rule topology: per-subject TFRs (rule tfr_subject) feed the
    group rules; this stats rule consumes the cohort's per-subject condition
    TFRs for both contrast arms (the one-sample difference design needs the
    per-subject maps, not the group averages). For each product an
    independent one-sample cluster permutation test runs over the
    (channel x freq x time) difference grid: power uses the raw difference
    (matching the persisted difference map); ITPC uses the Fisher-z
    transform (:func:`p0ly_utils.analysis.itpc_z`) before differencing.
    Statistic conventions, adjacency and the ClusterPermStats reuse mirror
    run_erp (US-010); the DAG omits these targets for cohorts with < 2
    subjects (see _TFR_CLUSTER_COHORTS).

    Outputs (cohort-tier under group_analysis/{timelock}/{cohort}/, one job
    writes both):
      - {condA}-vs-{condB}_tfrcluster.npz : per statistic (``power``,
        ``itpc``) — t_obs (n_channels, n_freqs, n_times), per-cluster
        p-values, sign-flip null maxima (h0), n_subjects, settings echo.
      - .csv : one row per (statistic, cluster): distinct channel/freq/time
        counts, index lists, p_value; header-only when no cluster formed.
    """
    conda:
        "envs/snakemake.yaml"
    input:
        cond_first=lambda wildcards: expand(
            _TFR_SUBJECT_OUT,
            subject=_COHORT_SUBJECTS[wildcards.cohort],
            timelock=wildcards.timelock,
            condition=_ERP_CONTRASTS[wildcards.contrast][0],
        ),
        cond_second=lambda wildcards: expand(
            _TFR_SUBJECT_OUT,
            subject=_COHORT_SUBJECTS[wildcards.cohort],
            timelock=wildcards.timelock,
            condition=_ERP_CONTRASTS[wildcards.contrast][1],
        ),
    output:
        npz=_TFR_CLUSTER_NPZ_OUT,
        csv=_TFR_CLUSTER_CSV_OUT,
    params:
        conditions=lambda wildcards: _ERP_CONTRASTS[wildcards.contrast],
        stats=_TFR_SETTINGS,
    log:
        "logs/group/run_tfr_cluster_{timelock}_{cohort}_{contrast}.log",
    script:
        "scripts/tfr_cluster.py"


rule connectivity_subject:
    """Per-method spectral connectivity for one subject's (timelock, condition).

    Reads the US-017 ``sub-{subject}_{timelock}_desc-epo.fif.gz`` epochs
    (carrying trial metadata), selects the condition via its ``metadata.eval``
    query from ``config.yaml group_aggregation.condition_splits`` (the
    reserved ``all_trials`` condition applies no query), and computes one
    ``mne_connectivity.spectral_connectivity_epochs`` call across all
    configured methods with ``config.yaml connectivity`` settings. The result
    keeps every channel (per-subject QC artifact) and is written as an ``.npz``
    archive — one ``(n_channels, n_channels, n_freqs)`` adjacency per method
    (symmetric, zero diagonal) plus ``ch_names`` and ``freqs``.
    """
    conda:
        "envs/snakemake.yaml"
    input:
        epochs=f"{_OUT_DIR}/sub-{{subject}}/sub-{{subject}}_{{timelock}}_desc-epo.fif.gz",
    output:
        conn=_CONN_SUBJECT_OUT,
    params:
        condition="{condition}",
        condition_query=lambda wildcards: _CONN_QUERIES[wildcards.condition],
        connectivity=_CONN_SETTINGS,
    log:
        "logs/sub-{subject}/connectivity_subject_{timelock}_{condition}.log",
    script:
        "scripts/connectivity_subject.py"


rule connectivity_group_average:
    """Equal-weight grand average of per-method adjacencies across subjects.

    Consumes the per-subject ``desc-conn.npz`` archives (rule
    connectivity_subject) and writes
    ``group_analysis/{timelock}/{condition}_desc-conn_ave.npz`` (same archive
    layout) via ``p0ly_utils.analysis.group_connectivity`` (equal-weight mean
    with channel-set + method + frequency-grid guards).
    """
    conda:
        "envs/snakemake.yaml"
    input:
        subject_conns=lambda wildcards: expand(
            _CONN_SUBJECT_OUT,
            subject=_COHORT_SUBJECTS[wildcards.cohort],
            timelock=wildcards.timelock,
            condition=wildcards.condition,
        ),
    output:
        ave=_CONN_GROUP_OUT,
    params:
        methods=lambda wildcards: _CONN_SETTINGS["methods"],
        fisher_z=lambda wildcards: _CONN_SETTINGS["fisher_z_average"],
    log:
        "logs/group/connectivity_group_average_{timelock}_{cohort}_{condition}.log",
    script:
        "scripts/connectivity_group_average.py"


rule run_connectivity:
    """Graph metrics of the band-averaged group connectivity (timelock, condition).

    Input is the grand-average ``desc-conn_ave.npz`` (rule
    connectivity_group_average — one read, not N subject re-reads). Each
    method's adjacency is band-averaged (``config.yaml connectivity.bands``,
    inclusive windows) and thresholded (``min_edge_weight`` noise floor), and
    ``p0ly_utils.analysis.graph_metrics`` reports weighted clustering, the
    characteristic path length (largest connected component, effective
    distance ``1/weight``) and strength centrality as one long-format CSV
    ``(method, band, node)``. No statistical test: defined at n=1, mirroring
    PSD/TFR. Per-contrast difference graphs live in rule
    ``connectivity_contrast`` (US-013 deferral) — difference adjacencies
    compound sign flips of near-zero couplings, so they are labelled
    condition differences, not physical coupling strengths.
    """
    conda:
        "envs/snakemake.yaml"
    input:
        ave=_CONN_GROUP_OUT,
    output:
        graph=_CONN_GRAPH_OUT,
    params:
        methods=lambda wildcards: _CONN_SETTINGS["methods"],
        bands=lambda wildcards: _CONN_SETTINGS["bands"],
        min_edge_weight=lambda wildcards: _CONN_SETTINGS["min_edge_weight"],
    log:
        "logs/group/run_connectivity_{timelock}_{cohort}_{condition}.log",
    script:
        "scripts/run_connectivity.py"


rule connectivity_contrast:
    """Graph metrics of the per-contrast difference connectivity (US-013).

    Reads the two grand-average ``desc-conn_ave.npz`` archives of a
    contrast pair (rule connectivity_group_average; the contrast name is
    an unordered ``condition_splits`` pair ``first-vs-second``) and writes
    ``group_analysis/{timelock}/{cohort}/{contrast}_desc-conn_diff-graph.csv``
    via ``p0ly_utils.analysis.difference_connectivity`` — the plain
    ``first - second`` condition difference, band-averaged and thresholded
    exactly like rule run_connectivity. Defined for any n (a difference of
    grand means, no statistics); the one-sample per-subject difference
    machinery is US-026's. Difference adjacencies compound sign flips of
    near-zero couplings — interpret as condition differences only.
    """
    conda:
        "envs/snakemake.yaml"
    input:
        ave_first=lambda wildcards: _CONN_GROUP_OUT.format(
            timelock=wildcards.timelock,
            cohort=wildcards.cohort,
            condition=_ERP_CONTRASTS[wildcards.contrast][0],
        ),
        ave_second=lambda wildcards: _CONN_GROUP_OUT.format(
            timelock=wildcards.timelock,
            cohort=wildcards.cohort,
            condition=_ERP_CONTRASTS[wildcards.contrast][1],
        ),
    output:
        graph=_CONN_CONTRAST_OUT,
    params:
        contrast_pair=lambda wildcards: _ERP_CONTRASTS[wildcards.contrast],
        methods=lambda wildcards: _CONN_SETTINGS["methods"],
        bands=lambda wildcards: _CONN_SETTINGS["bands"],
        min_edge_weight=lambda wildcards: _CONN_SETTINGS["min_edge_weight"],
    log:
        "logs/group/connectivity_contrast_{timelock}_{cohort}_{contrast}.log",
    script:
        "scripts/connectivity_contrast.py"


# --- Regression Analysis Layer (US-014) ---
# Two rules: per-subject OLS beta maps, then the equal-subject-weight cohort
# mean. Both are thin I/O shims — design-matrix construction, validation and
# the solve live in p0ly_utils.analysis (DoD: no algorithm logic in scripts).
rule regression_subject:
    """OLS beta maps for one subject's timelock over all retained trials.

    Reads the US-017 ``sub-{subject}_{timelock}_desc-epo.fif.gz`` epochs
    (carrying trial metadata) and calls
    ``p0ly_utils.analysis.regression_epochs`` with the ``config.yaml
    regression:`` predictor declaration — ``signal_domain`` (voltage |
    power), ``continuous`` numeric columns and ``categorical``
    reference-coded columns. The library owns the design matrix, the
    complete-case exclusion bookkeeping and the OLS solve; the power domain
    reuses the ``tfr:`` block (passed as ``params.tfr``) even when
    ``analysis.run_tfr`` is false. Rows with unusable predictors are
    excluded loudly and counted, and invalid designs fail the job rather
    than being silently dropped.

    Output: ``sub-{subject}_{timelock}_desc-regression.npz`` — ``betas``
    with the domain-specific leading term axis
    ``(n_terms, n_channels, n_times)`` / ``(n_terms, n_channels, n_freqs,
    n_times)``, ``terms``, ``ch_names``, ``times``, ``freqs`` (power only),
    ``domain``, ``reference_levels_json``, ``n_input``, ``n_used``,
    ``n_excluded``, ``excluded_rows`` (SCHEMA §regression).
    """
    conda:
        "envs/snakemake.yaml"
    input:
        epochs=f"{_OUT_DIR}/sub-{{subject}}/sub-{{subject}}_{{timelock}}_desc-epo.fif.gz",
    output:
        npz=_REG_SUBJECT_OUT,
    params:
        regression=_REG_SETTINGS,
        tfr=_REG_TFR_SETTINGS,
    log:
        "logs/sub-{subject}/regression_subject_{timelock}.log",
    script:
        "scripts/regression_subject.py"


rule run_regression:
    """Equal-subject-weight cohort mean of the per-subject beta maps.

    Inputs are the cohort's per-subject ``desc-regression.npz`` archives
    (rule regression_subject, US-015 cohort membership) — never the original
    epochs, so the cohort value cannot become a pooled-trial estimate.
    ``p0ly_utils.analysis.group_regression`` averages the subject maps with
    equal subject weight and guards domain, term order, reference levels,
    channel set and response grid. Output:
    ``group_analysis/{timelock}/{cohort}/desc-regression_ave.npz`` (same
    payload minus the exclusion bookkeeping, plus ``n_subjects`` and
    ``n_trials_used_total``). No inferential output lives here.
    """
    conda:
        "envs/snakemake.yaml"
    input:
        subject_npzs=lambda wildcards: expand(
            _REG_SUBJECT_OUT,
            subject=_COHORT_SUBJECTS[wildcards.cohort],
            timelock=wildcards.timelock,
        ),
    output:
        ave=_REG_GROUP_OUT,
    log:
        "logs/group/run_regression_{timelock}_{cohort}.log",
    script:
        "scripts/run_regression.py"


# --- Cross-Frequency Coupling Rules (US-027) ---
# ADR-007 three-rule topology: per-subject maps (with their full surrogate
# nulls) feed a descriptive cohort mean and the subject-unit contrast. All
# math lives in p0ly_utils.analysis (DoD: no coupling/null/averaging logic in
# rule scripts); the scripts deserialize, call one library function, and save.
rule cfc_subject:
    """PAC + n:m PPC maps for one subject's (timelock, condition).

    Reads the US-017 ``sub-{subject}_{timelock}_desc-epo.fif.gz`` epochs
    (carrying trial metadata), selects the condition via its ``metadata.eval``
    query from ``config.yaml group_aggregation.condition_splits`` (the
    reserved ``all_trials`` condition applies no query), and calls
    ``p0ly_utils.analysis.estimate_cfc`` with ``config.yaml cfc`` grids,
    bandwidths, ratios, surrogate count and seed. One call covers every
    configured method: PAC (tensorpac Gaussian-copula by default, all channels
    in one call) and each integer-ratio n:m phase-phase map (Hilbert phases,
    mean resultant length). Fails loud on zero query matches, sub-Nyquist or
    negative band edges, too few trials/samples, and off-ratio
    ``ratio_tolerance`` settings (US-024 philosophy).

    Output is a compressed ``desc-cfc.npz`` archive — per method ``<key>``
    (``pac``, ``ppc_2x1``, ...) the observed map
    ``(n_channels, n_phase_freqs, n_amp_freqs)``, the full surrogate null
    ``(n_surrogates, n_channels, n_phase_freqs, n_amp_freqs)``, the one-sided
    empirical p-values and the valid-cell mask, plus shared axes and
    ``evidence_level="subject"`` (descriptive, uncorrected — NOT cohort
    evidence).
    """
    conda:
        "envs/snakemake.yaml"
    input:
        epochs=f"{_OUT_DIR}/sub-{{subject}}/sub-{{subject}}_{{timelock}}_desc-epo.fif.gz",
    output:
        cfc=_CFC_SUBJECT_OUT,
    params:
        subject="{subject}",
        condition="{condition}",
        condition_query=lambda wildcards: _CFC_QUERIES[wildcards.condition],
        cfc=_CFC_SETTINGS,
    log:
        "logs/sub-{subject}/cfc_subject_{timelock}_{condition}.log",
    script:
        "scripts/cfc_subject.py"


rule cfc_group_average:
    """Equal-subject-weight descriptive CFC mean across a cohort (any n >= 1).

    Consumes the cohort's per-subject ``desc-cfc.npz`` archives (rule
    cfc_subject, US-015 cohort-restricted) and calls
    ``p0ly_utils.analysis.group_cfc`` — arithmetic subject mean with
    channel-set / method / grid / valid-mask guards. Only **observed** maps are
    read: subject nulls and p-values never enter cohort math, so the archive
    carries no averaged p-values (``evidence_level="cohort_descriptive"``).
    Valid at n=1; off-ratio PPC cells stay NaN.
    """
    conda:
        "envs/snakemake.yaml"
    input:
        subject_maps=lambda wildcards: expand(
            _CFC_SUBJECT_OUT,
            subject=_COHORT_SUBJECTS[wildcards.cohort],
            timelock=wildcards.timelock,
            condition=wildcards.condition,
        ),
    output:
        ave=_CFC_GROUP_OUT,
    log:
        "logs/group/cfc_group_average_{timelock}_{cohort}_{condition}.log",
    script:
        "scripts/cfc_group_average.py"


rule run_cfc:
    """Subject-unit CFC condition contrast with full-map correction (US-027).

    Inputs are the cohort's per-subject condition archives for both contrast
    arms (rule cfc_subject — the paired test needs the per-subject maps, not
    the descriptive averages). ``p0ly_utils.analysis.cfc_condition_contrast``
    builds per-subject ``first - second`` difference maps, flips each
    subject's whole difference map under the null (first subject fixed to
    +1 to remove global sign symmetry), takes the max |statistic| over each
    method's valid cells per resample, and corrects every observed cell with
    that full-map max distribution:

        p_corrected = (1 + #null_max >= |observed|) / (n_resamples + 1)

    Exact enumeration yields ``2 ** (n_subjects - 1)`` null maxima when that
    fits under ``cfc.n_permutations``, otherwise that many seeded random
    patterns (observed all-+ included once). Small cohorts therefore have a
    p-value floor (n=2 -> 1/3, n=6 -> 1/33); the DAG omits these targets for
    cohorts with < 2 subjects (see _CFC_CONTRAST_COHORTS). Subject surrogate
    p-values are never combined here — the library signature accepts observed
    maps only.

    Output (cohort-tier under group_analysis/{timelock}/{cohort}/): per method
    ``<key>__difference``, ``<key>__pvalues_corrected``, ``<key>__null_max``,
    ``<key>__valid_mask``, plus shared axes, ``conditions``, subject/permutation
    counts, ``correction`` and ``evidence_level="cohort_subject_unit"``.
    """
    conda:
        "envs/snakemake.yaml"
    input:
        maps_first=lambda wildcards: expand(
            _CFC_SUBJECT_OUT,
            subject=_COHORT_SUBJECTS[wildcards.cohort],
            timelock=wildcards.timelock,
            condition=_ERP_CONTRASTS[wildcards.contrast][0],
        ),
        maps_second=lambda wildcards: expand(
            _CFC_SUBJECT_OUT,
            subject=_COHORT_SUBJECTS[wildcards.cohort],
            timelock=wildcards.timelock,
            condition=_ERP_CONTRASTS[wildcards.contrast][1],
        ),
    output:
        perm=_CFC_CONTRAST_OUT,
    params:
        conditions=lambda wildcards: _ERP_CONTRASTS[wildcards.contrast],
        stats=_CFC_SETTINGS,
    log:
        "logs/group/run_cfc_{timelock}_{cohort}_{contrast}.log",
    script:
        "scripts/run_cfc.py"


# --- Variability Analysis Layer (US-029) ---
# Across-trial variability per (subject, timelock, condition) -> cohort maps.
# All math lives in p0ly_utils.analysis.variability (DoD: no algorithm logic
# in rule scripts); no statistics, so single-subject cohorts run everything.
rule variability_subject:
    """Variability maps of one subject's (timelock, condition).

    Reads the US-017 ``sub-{subject}_{timelock}_desc-epo.fif.gz`` epochs
    (carrying trial metadata), selects the condition via its ``metadata.eval``
    query from ``config.yaml group_aggregation.condition_splits`` (the
    reserved ``all_trials`` condition applies no query), and lets
    ``p0ly_utils.analysis.variability_epochs`` compute every configured
    domain/measure (``config.yaml variability``) in one read: voltage ->
    sample SD; power -> SD/Fano/CV from the TFR transform (``config.yaml
    tfr``, independent of analysis.run_tfr). Fails loud on zero query matches
    or fewer than two trials (US-024 philosophy). One ``.npz`` archive holds
    ``{domain}__{measure}`` maps plus the power ``positive_mean`` mask,
    ``{domain}__measures``, ``ch_names``, ``times``, power ``freqs``/
    ``power__times`` and ``n_trials`` — no pickled objects.
    """
    conda:
        "envs/snakemake.yaml"
    input:
        epochs=f"{_OUT_DIR}/sub-{{subject}}/sub-{{subject}}_{{timelock}}_desc-epo.fif.gz",
    output:
        npz=_VARIABILITY_SUBJECT_OUT,
    params:
        condition="{condition}",
        condition_query=lambda wildcards: _VARIABILITY_QUERIES[wildcards.condition],
        variability=_VARIABILITY_SETTINGS,
        tfr=_VARIABILITY_TFR,
    log:
        "logs/sub-{subject}/variability_subject_{timelock}_{condition}.log",
    script:
        "scripts/variability_subject.py"


rule run_variability:
    """Equal-subject-weight cohort variability maps (timelock, condition).

    Consumes the cohort's per-subject ``desc-variability.npz`` archives (rule
    variability_subject, US-015 cohort-restricted), rebuilds one
    ``VariabilityResult`` per subject and domain, and writes
    ``group_analysis/{timelock}/{cohort}/{condition}_desc-variability_ave.npz``
    via ``p0ly_utils.analysis.group_variability``: SD averages every subject,
    Fano/CV average only the subjects whose mean was positive at that cell
    (equal weight, never pooled trials) and persist per-cell
    ``{domain}__{measure}__n_contributing`` counts next to ``n_subjects`` —
    the changing denominator stays visible. No reductions happen here.
    """
    conda:
        "envs/snakemake.yaml"
    input:
        subject_variability=lambda wildcards: expand(
            _VARIABILITY_SUBJECT_OUT,
            subject=_COHORT_SUBJECTS[wildcards.cohort],
            timelock=wildcards.timelock,
            condition=wildcards.condition,
        ),
    output:
        ave=_VARIABILITY_GROUP_OUT,
    params:
        domains=lambda wildcards: list(_VARIABILITY_SETTINGS),
    log:
        "logs/group/run_variability_{timelock}_{cohort}_{condition}.log",
    script:
        "scripts/run_variability.py"
